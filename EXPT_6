
<!DOCTYPE html>
<html>
<head>
    <title>DriveLux Car Rental</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Drive<span>Lux</span></h1>
    <nav>
        <a href="#home">Home</a>
        <a href="#cars">Our Cars</a>
        <a href="#animation">Animation</a>
    </nav>
</header>

<section class="hero" id="home">
    <p class="small">PREMIUM CAR RENTALS</p>
    <h2>Find Your Perfect <span>Drive</span></h2>
    <p>Comfort, style and freedom for every journey.</p>
    <a href="#cars" class="button">Explore Cars</a>
    <h3>Current Time: <span id="time"></span></h3>
</section>

<section class="cars-section" id="cars">
    <h2>Our Popular Cars</h2>

    <div class="car-card" id="carCard">
        <img src="car.jpg" alt="Rental car" class="car-image">

        <div class="car-info">
            <p class="small">LUXURY SEDAN</p>
            <h3 id="carName">Premium Sedan</h3>
            <p id="details">Comfortable seating, air conditioning
                and a smooth driving experience.</p>
            <h3>₹2,500 / day</h3>

            <button onclick="changeStyle()">Change Style</button>
            <button onclick="toggleDetails()">Show / Hide Details</button>
        </div>
    </div>
</section>

<section class="animation-section" id="animation">
    <h2>Watch Your Drive</h2>
    <p>Click Start to move the car and Stop to pause it.</p>

    <div id="road">
        <img src="car.jpg" id="movingCar" alt="Moving car">
    </div>

    <button onclick="startCar()">Start Animation</button>
    <button onclick="stopCar()">Stop Animation</button>
</section>

<footer>
    <h2>DriveLux</h2>
    <p>Your journey, our priority.</p>
    <p>© 2026 DriveLux Car Rental</p>
</footer>

<script>
function changeStyle() {
    let card = document.getElementById("carCard");

    card.style.backgroundColor = "#222";
    card.style.color = "#d9a441";
    card.style.border = "2px solid #d9a441";
}

function toggleDetails() {
    let details = document.getElementById("details");

    if (details.style.display === "none") {
        details.style.display = "block";
    } else {
        details.style.display = "none";
    }
}

function displayTime() {
    let now = new Date();

    document.getElementById("time").innerHTML =
        now.getHours() + ":" +
        String(now.getMinutes()).padStart(2, "0") + ":" +
        String(now.getSeconds()).padStart(2, "0");
}

setInterval(displayTime, 1000);
displayTime();

let position = 0;
let timer = null;

function startCar() {
    if (timer !== null) return;

    let car = document.getElementById("movingCar");
    let road = document.getElementById("road");

    timer = setInterval(function() {
        position++;

        if (position > road.clientWidth - car.offsetWidth) {
            position = 0;
        }

        car.style.left = position + "px";
    }, 20);
}

function stopCar() {
    clearInterval(timer);
    timer = null;
}
</script>

</body>
</html>
